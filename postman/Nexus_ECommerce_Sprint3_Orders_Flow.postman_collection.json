            {
              "name": "06.3.2 - Create New Category [201 Created]",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "const createCatRes = pm.response.json();",
                      "const newCategory = createCatRes.data || createCatRes;",
                      "pm.test('Category created with id and slug', function () {",
                      "    pm.expect(newCategory.id).to.be.a('string');",
                      "    pm.expect(newCategory.slug).to.be.a('string');",
