                  "    pm.environment.set('addressId', addresses[0].id);",
                  "} else {",
                  "    // Fallback known valid address ID for testing",
                  "    pm.environment.set('addressId', 'd39621ae-c9c6-4f06-8e09-faf9f2d7e2e5');",
                  "}"
