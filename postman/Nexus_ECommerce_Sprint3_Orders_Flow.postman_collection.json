    {
      "name": "04 - Checkout Flow [NEX-301.1]",
      "item": [
        {
          "name": "04.1 - Checkout (Create Session & Orders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const checkoutJson = pm.response.json();",
                  "const checkoutData = checkoutJson.data || {};",
                  "",
                  "pm.test('Checkout session created', function () {",
                  "    pm.expect(checkoutData.checkoutSessionId).to.be.a('string');",
                  "    pm.expect(checkoutData.orders).to.be.an('array');",
                  "    pm.expect(checkoutData.orders.length).to.be.above(0);",
                  "});",
                  "",
                  "if (checkoutData.checkoutSessionId) {",
                  "    pm.environment.set('checkoutSessionId', checkoutData.checkoutSessionId);",
                  "}",
                  "if (checkoutData.orders && checkoutData.orders[0]) {",
                  "    pm.environment.set('orderId', checkoutData.orders[0].id);",
                  "    pm.environment.set('orderNumber', checkoutData.orders[0].orderCode);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
