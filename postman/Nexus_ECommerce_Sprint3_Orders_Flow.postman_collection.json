{
  "info": {
    "_postman_id": "nexus-orders-flow-collection-sprint3",
    "name": "Nexus E-Commerce - Sprint 3 Orders, Checkout & Admin Flow",
    "description": "Automated End-to-End Postman Test Suite for Sprint 3 (NEX-301.1, NEX-301.2 & NEX-304 Admin Module).\n\nCovers:\n1. Authentication (Login & Auto-Token extraction)\n2. Catalog Product & Default SKU lookup\n3. Buyer Delivery Address lookup/ensure\n4. Add to Cart & Fetch Cart items\n5. Checkout flow (NEX-301.1: Multi-seller order split, snapshot creation, cart cleanup)\n6. My Orders List (Envelope validation, pagination)\n7. Order Detail by ID with Status History (NEX-301.2)\n8. Admin Module (NEX-304: Dashboard Stats, User Management, Category Hierarchy CRUD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "01.1 - Login as Buyer / Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json.data?.accessToken || json.data?.data?.accessToken;",
                  "const user = json.data?.user || json.data?.data?.user;",
                  "",
                  "pm.test('Access token received', function () {",
                  "    pm.expect(token).to.be.a('string');",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.environment.set('accessToken', token);",
                  "}",
                  "if (user && user.id) {",
                  "    pm.environment.set('userId', user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nexus.vn\",\n  \"password\": \"Admin@123456\",\n  \"captchaToken\": \"bypass-recaptcha-dev\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
