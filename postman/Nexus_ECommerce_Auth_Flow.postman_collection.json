{
  "info": {
    "_postman_id": "nexus-auth-flow-collection-v1",
    "name": "Nexus E-Commerce - Auth Flow Automation",
    "description": "Automated Postman test suite for Authentication, User Profile, and Address lifecycle in Nexus E-Commerce Backend (NEX-116 / NEX-106).\n\nCovers:\n- User Registration (Success, Conflict 409, Validation 400)\n- Authentication / Login (Success 200, Invalid Credentials 401)\n- Current User Profile /me (Success 200, Missing Token 401)\n- Profile Update (Success 200, Empty Body 400)\n- Token Rotation / Refresh (Success 200, HttpOnly Cookie)\n- Change Password & Invalidation (Success 200, Wrong Current Password 400, Old Token Revocation 401)\n- Address CRUD lifecycle (Authentication 401, Create 201, List/Update 200, Validation 400, Missing 404, Delete 204)\n- Logout & Post-Logout Revocation (Success 200, Refresh After Logout 401)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Register",
      "item": [
        {
          "name": "01.1 - Register Success [201]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique dynamic test user parameters to avoid collisions across runs",
                  "const timestamp = Date.now();",
                  "const randomDigits = Math.floor(10000000 + Math.random() * 90000000);",
                  "const testEmail = `runner_user_${timestamp}@nexus-test.com`;",
                  "const testPassword = `Nexus@Pass${timestamp.toString().slice(-4)}!`;",
                  "const testFullName = `Runner Test User ${timestamp.toString().slice(-4)}`;",
                  "const testPhone = `09${randomDigits}`;",
                  "const newPassword = `Nexus@NewPass${timestamp.toString().slice(-4)}!`;",
                  "",
                  "pm.environment.set('testEmail', testEmail);",
                  "pm.environment.set('testPassword', testPassword);",
                  "pm.environment.set('testFullName', testFullName);",
                  "pm.environment.set('testPhone', testPhone);",
                  "pm.environment.set('newPassword', newPassword);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response matches standard envelope', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.message).to.equal('Đăng ký tài khoản thành công');",
                  "});",
                  "",
                  "pm.test('User registration payload is sanitized and accurate', function () {",
                  "    const user = pm.response.json().data.data;",
                  "    pm.expect(user.id).to.be.a('string');",
                  "    pm.expect(user.email).to.equal(pm.environment.get('testEmail'));",
                  "    pm.expect(user.fullName).to.equal(pm.environment.get('testFullName'));",
                  "    pm.expect(user.phone).to.equal(pm.environment.get('testPhone'));",
                  "    pm.expect(user.status).to.equal('ACTIVE');",
                  "    pm.expect(user).to.not.have.property('passwordHash');",
                  "    pm.environment.set('userId', user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"{{testFullName}}\",\n  \"phone\": \"{{testPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "01.2 - Register Duplicate Email [409 Conflict]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
