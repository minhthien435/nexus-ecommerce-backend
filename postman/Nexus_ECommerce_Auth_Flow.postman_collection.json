        {
          "name": "02.2 - Login Success [200 OK]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response envelope contains accessToken and user info', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.message).to.equal('Đăng nhập thành công');",
                  "",
                  "    const authData = json.data.data;",
                  "    pm.expect(authData.accessToken).to.be.a('string').that.is.not.empty;",
                  "    pm.expect(authData.user.email).to.equal(pm.environment.get('testEmail'));",
                  "",
                  "    // Store accessToken for subsequent authenticated calls",
                  "    pm.environment.set('accessToken', authData.accessToken);",
                  "});",
                  "",
                  "pm.test('Set-Cookie header sets HttpOnly refreshToken', function () {",
                  "    const setCookie = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(setCookie).to.be.a('string');",
                  "    pm.expect(setCookie).to.include('refreshToken=');",
                  "    pm.expect(setCookie.toLowerCase()).to.include('httponly');",
                  "});"
                ]
              }
            }
