# Nexus E-Commerce Environment Configuration

# Server Environment
NODE_ENV=development
PORT=3000

# Supabase API Configuration
SUPABASE_URL=https://plldmvgztekeiwcweiti.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsbGRtdmd6dGVrZWl3Y3dlaXRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMjY1MDEsImV4cCI6MjEwMTYwMjUwMX0.8uo1MikO6g5Eoz_juamlbQosOkqu_go4IIA4B92Ibn0
SUPABASE_STORAGE_BUCKET=nexus-media

# Database Configuration (Supabase PostgreSQL 17 - Port 5432 Session Pooler / IPv4 Compatible)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.plldmvgztekeiwcweiti
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_DATABASE=postgres
DB_SSL=true

# Connection String (Luu y: neu mat khau co ky tu @, can encode thanh %40)
DATABASE_URL=postgresql://postgres.plldmvgztekeiwcweiti:YOUR_DB_PASSWORD_HERE@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis Configuration (Sprint 2 - Caching & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=500

# JWT Secrets (Sprint 1 - Identity Module)
JWT_ACCESS_SECRET=nexus_super_secret_access_key_min_32_characters_long_2026
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=nexus_super_secret_refresh_key_min_32_characters_long_2026
JWT_REFRESH_EXPIRES_IN=7d

# Third-party authentication verification (server-side only)
RECAPTCHA_SECRET_KEY=
# Optional exact hostname returned by reCAPTCHA, for example localhost or nexus.example.com
RECAPTCHA_EXPECTED_HOSTNAME=
GOOGLE_CLIENT_ID=

# Outbound email (server-side only)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Initial Admin Seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Nexus Administrator


# PayOS Payment Gateway Configuration
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_RETURN_URL=http://localhost:5173/checkout/payment-result
PAYOS_CANCEL_URL=http://localhost:5173/checkout/payment-result

# GHN Express Logistics Configuration (Sprint 3 - Fast Shipping)
# Sandbox API Endpoint: https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_API_TOKEN=your_ghn_sandbox_api_token
GHN_SHOP_ID=your_ghn_sandbox_shop_id
# Optional explicit GHN legacy pickup location, configure both values together.
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
# Webhook signature/token verification for carrier tracking callbacks
GHN_WEBHOOK_TOKEN=your_ghn_webhook_secret_token

# Required real two-level GHN pickup address (never use placeholder values).
GHN_FROM_NAME=
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_PROVINCE_NAME=
GHN_FROM_WARD_NAME=

# Gemini AI assistant (server only; real agent requires Minh integration)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Set an enabled Gemini model ID from your Google project; no application default.
GEMINI_MODEL=

# AI v2: configure a supported model above; no default model.
GEMINI_TIMEOUT_MS=15000
AI_MAX_TOOL_ROUNDS=4
AI_RATE_LIMIT_GUEST=10
AI_RATE_LIMIT_USER=20
# Demo fixture only. Requires NODE_ENV=development or test; never production.
AI_MOCK_ENABLED=false
